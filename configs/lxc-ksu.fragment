# ---------------------------------------------------------------------------
# Redmi K30 Ultra (cezanne) / MT6889 / kernel 4.14.186
# LXC + KernelSU 需要的额外内核配置
#
# 语法: CONFIG_FOO=y / CONFIG_FOO=n / CONFIG_FOO="string"
# scripts/build.sh 会逐条写入 out/.config，再执行 make olddefconfig，
# 最后逐条回读校验；任何一条没生效都会直接失败并打印清单。
# ---------------------------------------------------------------------------

# ---- Linux namespaces：容器隔离的基础 -------------------------------------
# NAMESPACES / UTS_NS / IPC_NS / PID_NS / NET_NS 在 4.14 里默认就是 y，
# 这里显式写出来是为了防止厂商 defconfig 在某次更新中改掉。
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
# USER_NS 默认 n，必须显式打开（rootless 容器 / podman 依赖它）
CONFIG_USER_NS=y

# ---- cgroup v1 控制器 ------------------------------------------------------
# CGROUPS 因 CPUSETS=y 已被隐式选中，其余控制器默认都是 n。
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_MEMCG=y
CONFIG_CPUSETS=y

# ---- 容器运行所需的基础设施 -------------------------------------------------
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_KEYS=y
# KernelSU 的 Kconfig 直接 depends on OVERLAY_FS，不开会导致 CONFIG_KSU 被丢弃
CONFIG_OVERLAY_FS=y
CONFIG_DEVTMPFS=y
CONFIG_TMPFS=y

# ---- 容器网络（veth / NAT 出网）--------------------------------------------
CONFIG_VETH=y
CONFIG_TUN=y
CONFIG_BRIDGE=y
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y

# ---- KernelSU --------------------------------------------------------------
CONFIG_KSU=y
# 4.14 里 KPROBES 依赖 MODULES，显式写上防止被裁剪
CONFIG_MODULES=y
# kprobe 集成方式（默认）。若改用 manual hooks，build.sh 会自动把这里改成 n。
CONFIG_KPROBES=y
CONFIG_KALLSYMS=y

# ---- 便于在设备上核对配置 ---------------------------------------------------
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
